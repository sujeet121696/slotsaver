# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.wrangler

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Secrets — API keys must only ever live in env files, never in code
.env
.env.*
*.pem
*.key

# Real data — patient lists / phone numbers / call transcripts stay local
data/
*.csv
transcripts/

# Generated by each demo run (demo_board.html reads it live)
board.json

# Cloudflare Pages deploy folder — regenerated from demo_board.html
site/

# Reference-only material, never committed (same rule as resolve)
backup/

# Personal submission notes — contain real phone/email, never publish
docs/SUBMISSION.md

# Pitch deck — submission material, uploaded to Devpost directly, not repo code
docs/*.pptx

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.dev.vars*
!.dev.vars.example
!.env.example
