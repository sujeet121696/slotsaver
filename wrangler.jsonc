{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slotsaver-board",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site"
  },
  "routes": [
    { "pattern": "slotsaver.kharidwise.com", "custom_domain": true }
  ]
}
