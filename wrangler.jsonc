{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slotsaver-board",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "8f0c0ca910de4af7aef6bff1ee347919" }
  ],
  "routes": [
    { "pattern": "slotsaver.kharidwise.com", "custom_domain": true }
  ],
  // Automatic evening run: ticks every 2 minutes across 13:00-15:58 UTC
  // (18:30-21:28 IST) — the run kicks off at 13:30 UTC (7:00 PM IST) and
  // subsequent ticks in the window just advance it. Remove this block to
  // stop the daily automatic real calls; the manual button is unaffected.
  "triggers": {
    "crons": ["*/2 13-15 * * *"]
  }
}
