{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slotsaver-board",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "8f0c0ca910de4af7aef6bff1ee347919" }
  ],
  "routes": [
    { "pattern": "slotsaver.kharidwise.com", "custom_domain": true }
  ]
}
