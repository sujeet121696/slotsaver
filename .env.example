# Copy to .env and fill in — .env is gitignored, never commit real values.

# CALL-E API key from the heycall-e.com dashboard.
# Leave empty (or omit) to run with the mock caller — no real calls placed.
CALLE_API_KEY=

# Comma-separated E.164 numbers real calls are ALLOWED to dial (phones we
# own, playing the patients). Empty = no real call can be placed at all.
ALLOWED_DEMO_PHONES=

# Groq API key — powers the Strands agent brain (--brain strands).
# Leave empty to use the deterministic engine brain only.
GROQ_API_KEY=

# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# CLINIC_NAME=Dr. Meera's Dental Clinic
# AGENT_PERSONA=Asha
# DOCTOR_NAME=Dr. Meera
# BOARD_PATH=board.json                        # where the live board snapshot goes
# CALLE_REGION=IN                              # recipient region code
# CALLE_LOCALE=en-US                           # conversation locale
# CALLE_TIMEOUT_SECONDS=300                    # max wait per call
# GROQ_BASE_URL=https://api.groq.com/openai/v1 # any OpenAI-compatible API
# TEST_PATIENT_NAME=Rohit Sharma               # who test_call asks for
